{ sources, ... }:
{
  flake.modules.nixos.secrets = {
    imports = [ "${sources.sops-nix}/modules/sops" ];
    # Use the host's SSH identity for age decryption. Only encrypted payloads
    # belong in ./secrets; private identities stay on the host/off-repository.
    # Read the persistent backing file directly, even before /etc bind/link
    # setup. The identity itself is generated by OpenSSH on the first boot.
    sops.age.sshKeyPaths = [ "/persist/etc/ssh/ssh_host_ed25519_key" ];
    sops.gnupg.sshKeyPaths = [ ];

    # No secrets are required to boot this scaffold. Once encrypted:
    # sops.defaultSopsFile = ../secrets/arbour-haus.yaml;
    # sops.secrets.example = { };
    # Consumers must use config.sops.secrets.example.path, not builtins.readFile.
  };
}
